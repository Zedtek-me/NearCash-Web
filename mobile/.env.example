# GraphQL endpoint; set this to the same endpoint used by the web client.
EXPO_PUBLIC_NEARCASH_GRAPHQL_API_URL=https://your-api.example.com/api/v1/graph/

# WebSocket base URL, including the /ws prefix if your backend is mounted there.
EXPO_PUBLIC_SOCKET_URL=wss://your-api.example.com/ws

# Restrict this Android Maps key to the mobile package and signing certificate.
GOOGLE_MAPS_ANDROID_API_KEY=

# Optional EAS project identifier after running eas init.
EAS_PROJECT_ID=
